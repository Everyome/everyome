# Intent: the source package carries the tests (and their helper), the citation, the licences and the installer.
include LICENSE THIRD_PARTY_NOTICES.md ACKNOWLEDGEMENTS.md CITATION.cff README.md install.sh
recursive-include tests *.py
include CONTRIBUTING.md CODE_OF_CONDUCT.md
recursive-include tests/fixtures *
recursive-include docs *.md
recursive-include registry-template *
global-exclude __pycache__ *.pyc
